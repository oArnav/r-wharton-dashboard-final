# ==============================================================================
# Wharton Investment Simulator (WInS) — Environment Configuration Template
# ==============================================================================

# Supabase Project Credentials
# Obtain these from: https://supabase.com/dashboard/project/<project_id>/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Server Port (optional, defaults to 8000 locally)
PORT=8000

# Optional custom database path for SQLite fallback/testing
# WINS_DB_PATH=./backend/wins_data.db
